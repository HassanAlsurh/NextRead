            <p class="hero-subtitle">Join a community of book lovers sharing, reviewing, and discovering their favorite
                stories.</p>

            <div class="hero-actions">
                <% if (user) { %>
                    <a href="/books" class="btn primary-btn">Browse Recommendations</a>
