<%- include("../partials/nav.ejs") %>

    <div class="books-listing-container">
<div class="poster-details">
  <div class="user-PFP"><img src="<%= poster.profilePicture.url %>" alt=""></div>
  <div class="poster-username">
    <%= poster.username %>
  </div>
</div>


      <% if (book.userId._id.equals(user.id)) { %>
  <div class="owner-controlls-container">
    <form action="/books/<%= book._id %>/?_method=DELETE" method="post">
      <button type="submit">Delete Post</button>
    </form>
    <div class="edit-listing">
      <a href="/books/<%= book._id %>/edit">Edit Post</a>
    </div>
  </div>      
  <% } %>


      <div class="a-book-container">
        <img src="<%= book.bookCover.url %>" alt="<%= book.bookTitle %> book cover">
        <%= book.bookTitle %>
        <%= book.bookAuthor %>
        <div class="genres">
          <% book.genre.forEach((genre) => { %>
          <div class="a-genre-pill">
            <%= genre %>
          </div>
          <% }) %>
        </div>
        <div class="summary-container">
          <%= book.summary %>
        </div>
        <div class="user-thoughts-container">
          <%= book.userThoughts %>
        </div>

        <div class="meta-info">
          <span><%= book.createdAt.toLocaleDateString() %></span> 

          <% if (book.createdAt.getTime() !== book.updatedAt.getTime()) { %>
          <span class="edited-badge">(Edited)</span>
          <% } %>
        </div>
      </div>

      <div class="interactions-container">
        <!-- likes an ddislikes -->
      </div>

    </div>

    <div class="comment-section-container">
      <h2>Commments Section</h2>
      <div class="add-a-comment">
    <form action="/books/<%= book._id %>/comments" method="post">
      <center><textarea name="text" rows="4"  style="width: 80%; " placeholder="Write a comment..."></textarea></center><br/>
        <button type="submit">Send</button>
    </form>
      </div>
      <div class="comments-container">
            <ul>
        <!-- <%# current.questions.forEach((item) => { %> -->
         <li>
          <div class="commenter-username"><%#= item.author.username %> </div>
          <div class="comment-content"><%#= item.text %></div>
         </li>
        <!-- <%# }) %> -->
    </ul>
      </div>
    </div>
  </body>
</html>
