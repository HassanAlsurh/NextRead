<%- include("../partials/nav.ejs") %>

<main class="browse-container">
  <div class="browse-header">
    <h1>Community Recommendations</h1>
    <% if (user) { %>
      <a href="/books/new" class="btn primary-btn">Share a Book</a>
    <% } %>
  </div>

  <div class="browse-grid">
    <% books.forEach((item) => { %>
      <article class="book-card">
        
        <div class="poster-details">
          <% allUsers.forEach((currUser) => { %>
            <% if (currUser._id.equals(item.userId)) { %>
              <% if (currUser.profilePicture && currUser.profilePicture.url) { %>
                <img class="poster-pfp" src="<%= currUser.profilePicture.url %>" alt="Profile">
              <% } else { %>
                <img class="poster-pfp" src="https://res.cloudinary.com/iiye4e2g/image/upload/v1784386270/defualtPFP_z73q31.jpg" alt="Default">
              <% } %>
              <span class="poster-username"><%= currUser.username %></span>
            <% } %>
          <% }) %>
        </div>

        <a href="/books/<%= item._id %>" class="book-card-link">
          <div class="book-cover-wrapper">
            <img class="book-cover" src="<%= item.bookCover.url %>" alt="<%= item.bookTitle %> cover">
          </div>
          
          <div class="book-info">
            <h2 class="book-title"><%= item.bookTitle %></h2>
            <h3 class="book-author">by <%= item.bookAuthor %></h3>
            
            <div class="genres">
              <% item.genre.forEach((genre) => { %>
                <span class="genre-pill"><%= genre.replace(/-/g, ' ') %></span>
              <% }) %>
            </div>
            
            <p class="book-summary"><%= item.summary %></p>
            
            <div class="meta-info">
              <span><%= item.createdAt.toLocaleDateString() %></span> 
              <% if (item.createdAt.getTime() !== item.updatedAt.getTime()) { %>
                <span class="edited-badge">(Edited)</span>
              <% } %>
            </div>
          </div>
        </a>

      </article>
    <% }) %>
  </div>
</main>
</body>
</html>
