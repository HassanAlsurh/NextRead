<%- include("../partials/nav.ejs") %>

    <div class="books-listing-container">
      <% books.forEach((item) => { %>
        <a href="/books/<%= item._id %>">
  
      <div class="a-book-container">
        <img src="<%= item.bookCover.url %>" alt="<%= item.bookTitle %> book cover">
        <%= item.bookTitle %>
        <%= item.bookAuthor %>
        <div class="genres">
          <% item.genre.forEach((genre) => { %>
          <div class="a-genre-pill">
            <%= genre %>
          </div>
          <% }) %>
        </div>
        <div class="summary-container">
          <%= item.summary %>
        </div>
        <div class="user-thoughts-container">
          <%= item.userThoughts %>
        </div>

        <div class="meta-info">
          <span><%= item.createdAt.toLocaleDateString() %></span> 

          <% if (item.createdAt.getTime() !== item.updatedAt.getTime()) { %>
          <span class="edited-badge">(Edited)</span>
          <% } %>
        </div>
      </div>
      <hr>
      <hr>      
    </a>
      <% }) %>
    </div>
  </body>
</html>
