<%- include("../partials/nav.ejs") %>

  <main class="form-page-container">
    <section class="auth-card">
      <div class="auth-card-header">
        <h1 class="auth-card-title">Create Account</h1>
        <p class="auth-card-subtitle">
          Enter your details to join the community.
        </p>
      </div>

      <form class="auth-form" action="/auth/sign-up" method="POST">
        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input class="form-input" type="email" name="email" id="email" required>
        </div>
        
        <div class="form-group">
          <label class="form-label" for="username">Username</label>
          <input class="form-input" type="text" name="username" id="username" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input class="form-input" type="password" name="password" id="password" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="confirmPassword">Confirm Password</label>
          <input class="form-input" type="password" name="confirmPassword" id="confirmPassword" required>
        </div>

        <button class="btn primary-btn" style="width: 100%; margin-top: 1rem;" type="submit">Sign Up</button>
      </form>

      <p class="auth-card-footer">
        Already have an account? 
        <a class="text-link" href="/auth/sign-in">Sign In</a>
      </p>
    </section>
  </main>
</body>
</html>