<%- include("../partials/nav.ejs") %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In</title>
</head>
<body>
  <main class="form-page-container">
    <section class="auth-card">
      <div class="auth-card-header">
        <h1 class="auth-card-title">Sign In</h1>
        <p class="auth-card-subtitle">
          Enter your account details to continue.
        </p>
      </div>

      <form class="auth-form" action="/auth/sign-in" method="POST">
        <div class="form-group">
          <label class="form-label" for="username">Username</label>
          <input class="form-input" type="text" name="username" id="username" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input class="form-input" type="password" name="password" id="password" required>
        </div>

        <button class="btn primary-btn" style="width: 100%; margin-top: 1rem;" type="submit">Sign In</button>
      </form>

      <p class="auth-card-footer">
        Don't have an account?
        <a class="text-link" href="/auth/sign-up">Sign Up</a>
      </p>
    </section>
  </main>
</body>
</html>